---@meta
-- Static type stubs for the fixed agentd Lua API (`agentd.*`, `ctx.*`, and the
-- helper globals). Hand-maintained source; copied verbatim into a project's
-- `.luals/agentd.lua` by `agentctl types` and `agentd --watch`. The companion
-- `project.lua` supplies this project's own `agentd.ActionName`,
-- `agentd.RunnerName`, and `agentd.SkillName` names.

-- Registration: agentd.*

---@class agentd.ActionSpec
---@field name string                      Fully-qualified `tool.action` name.
---@field handler fun(args: table, ctx: Ctx): any
---@field requires? string[]               Permission slugs the action needs.
---@field confirm? boolean                 Require interactive approval per call.
---@field tool? string                     Owning tool; inferred from `name` if omitted.

---@class agentd.ToolSpec
---@field name string
---@field requires? string[]

---@class agentd.RunnerSpec
---@field name string
---@field model string                     `<provider>/<model_id>`.
---@field system? string
---@field skills? string[]
---@field actions? agentd.ActionName[]

---@class agentd.SkillSpec
---@field name string
---@field description? string
---@field system string
---@field actions? agentd.ActionName[]

---@class agentd.ServiceOpts
---@field restart? "always"|"on_failure"|"never"
---@field backoff_ms? integer
---@field backoff_max_ms? integer

-- Handles: every registration returns a live handle on what it registered.
-- Reading a property returns the current value; assigning one changes the
-- registered item (checked like registration). List properties are live, so
-- `table.insert(runner.skills, "tdd")` works. Assigning `name` renames.

---@class agentd.Runner
---@field name string
---@field model? string                    `<provider>/<model_id>`.
---@field system? string
---@field skills string[]
---@field allowed_actions agentd.ActionName[]
---@field actions agentd.ActionName[]      Same list as `allowed_actions`.
---@field cwd? string
---@field compact? table|false
---@field remove fun(self: agentd.Runner)

---@class agentd.Skill
---@field name string
---@field description? string
---@field system string
---@field actions agentd.ActionName[]
---@field source? string
---@field remove fun(self: agentd.Skill)

---@class agentd.Service
---@field name string
---@field tool? string
---@field source? string
---@field restart? "always"|"on_failure"|"never"
---@field backoff_ms? integer
---@field backoff_max_ms? integer
---@field handler fun(ctx: Ctx)
---@field remove fun(self: agentd.Service)

---@class agentd.Action
---@field name string
---@field tool? string
---@field requires string[]
---@field confirm boolean
---@field cwd? string
---@field input? table                     Reads back as the compiled JSON Schema.
---@field output? table                    Reads back as the compiled JSON Schema.
---@field handler fun(args: table, ctx: Ctx): any
---@field remove fun(self: agentd.Action)

---@class agentd.Tool
---@field name string
---@field requires string[]
---@field remove fun(self: agentd.Tool)

-- Collections: `find` takes a predicate, or a table whose keys must all match
-- (`*` wildcards for strings; a string matches any item of a list property).

---@class agentd.Runners
---@field list fun(): string[]
---@field get fun(name: string): agentd.Runner?
---@field find fun(query: table|fun(runner: agentd.Runner): boolean): agentd.Runner[]
---@field remove fun(name: string)

---@class agentd.Skills
---@field load fun(path: string): agentd.Skill     Load one Markdown skill file.
---@field dir fun(path: string): agentd.Skill[]    Load every `*.md` under a directory.
---@field list fun(): string[]
---@field get fun(name: string): agentd.Skill?
---@field find fun(query: table|fun(skill: agentd.Skill): boolean): agentd.Skill[]
---@field remove fun(name: string)

---@class agentd.Services
---@field list fun(): string[]
---@field get fun(name: string): agentd.Service?
---@field find fun(query: table|fun(service: agentd.Service): boolean): agentd.Service[]
---@field remove fun(name: string)

---@class agentd.Actions
---@field list fun(): string[]
---@field get fun(name: string): agentd.Action?
---@field find fun(query: table|fun(action: agentd.Action): boolean): agentd.Action[]
---@field remove fun(name: string)

---@class agentd.Tools
---@field list fun(): string[]
---@field get fun(name: string): agentd.Tool?
---@field find fun(query: table|fun(tool: agentd.Tool): boolean): agentd.Tool[]
---@field remove fun(name: string)

---@class agentd.Lib
---@field skills agentd.Skills
---@field runners agentd.Runners
---@field services agentd.Services
---@field actions agentd.Actions
---@field tools agentd.Tools
agentd = {}

---Register an action (table form), or the short `(name, handler)` form.
---@overload fun(name: string, handler: fun(args: table, ctx: Ctx): any): agentd.Action
---@param spec agentd.ActionSpec
---@return agentd.Action
function agentd.action(spec) end

---@param spec agentd.ToolSpec
---@return agentd.Tool
function agentd.tool(spec) end

---@param spec agentd.RunnerSpec
---@return agentd.Runner
function agentd.runner(spec) end

---@param spec agentd.SkillSpec
---@return agentd.Skill
function agentd.skill(spec) end

---Register a long-running service. `(name, fn)` or `(name, opts, fn)`.
---@overload fun(name: string, body: fun(ctx: Ctx)): agentd.Service
---@param name string
---@param opts agentd.ServiceOpts
---@param body fun(ctx: Ctx)
---@return agentd.Service
function agentd.service(name, opts, body) end

-- Globals

-- `import` is defined in the generated `project.lua` so its per-file
-- `---@overload` mappings (path string -> module type) live next to this
-- project's actual module list.

---@param ms integer
function sleep(ms) end

---Spawn a coroutine; await its result with `await`. The body may return a
---value (retrieved via `await`) or nothing.
---@generic T
---@param fn fun(): T?
---@return userdata handle
function async(fn) end

---@generic T
---@param handle userdata
---@return T
function await(handle) end

---Run functions concurrently; returns results in input order.
---@param fns (fun(): any)[]
---@param opts? { limit?: integer, settled?: boolean }
---@return any[]
function parallel(fns, opts) end

---@generic T, R
---@param items T[]
---@param fn fun(item: T, index: integer): R
---@param opts? { limit?: integer, settled?: boolean }
---@return R[]
function parallel_map(items, fn, opts) end

---@class agentd.Channel
---@field send fun(self: agentd.Channel, msg: any)
---@field recv fun(self: agentd.Channel): any
---@field try_recv fun(self: agentd.Channel): any|nil
---@field close fun(self: agentd.Channel)
---@field is_closed fun(self: agentd.Channel): boolean
---@field name string|nil

---Anonymous channel, or a named process-wide channel.
---@param name? string
---@return agentd.Channel
function channel(name) end

---@class agentd.Timer
---@field stop fun(self: agentd.Timer)

---@class agentd.TimerLib
---@field after fun(ms: integer, fn: fun()): agentd.Timer
---@field every fun(ms: integer, fn: fun()): agentd.Timer
timer = {}

---@class agentd.Json
---@field encode fun(value: any): string
---@field decode fun(text: string, opts?: { nulls?: "sentinel"|"nil" }): any
---@field null userdata
---@field is_null fun(value: any): boolean
json = {}

-- string helpers (added to the stock string library)

---@return string
function string.trim(s) end
---@return string
function string.ltrim(s) end
---@return string
function string.rtrim(s) end
---@return boolean
function string.startswith(s, prefix) end
---@return boolean
function string.endswith(s, suffix) end
---@return boolean
function string.contains(s, needle) end
---Split on a plain separator, or on whitespace when omitted.
---@param s string
---@param sep? string
---@return string[]
function string.split(s, sep) end

-- Invocation context: ctx

---@class Ctx.Log
---@field trace fun(msg: string)
---@field debug fun(msg: string)
---@field info fun(msg: string)
---@field warn fun(msg: string)
---@field error fun(msg: string)

---@class Ctx.ShellResult
---@field stdout string
---@field stderr string
---@field exit_code integer

---@class Ctx.ShellOpts
---@field bin string
---@field args? string[]
---@field cwd? string
---@field stdin? string
---@field separate_stderr? boolean

---@class Ctx.Fs
---@field read fun(path: string): string
---@field write fun(path: string, content: string): integer
---@field append fun(path: string, content: string): integer
---@field exists fun(path: string): boolean
---@field stat fun(path: string): table
---@field list_dir fun(path: string): table[]
---@field remove fun(path: string): integer
---@field history fun(path: string): Ctx.FileHistory
---@field diff fun(path: string, revision: integer): Ctx.FileDiff
---@field undo fun(path: string): integer
---@field redo fun(path: string): integer
---@field restore fun(path: string, revision: integer): integer
---Replace `old` with `new` in a file read earlier in this session (or run)
---and unchanged since. Without `replace_all`, `old` must appear once.
---@field edit fun(path: string, old: string, new: string, opts?: { replace_all?: boolean }): integer
---Apply a unified diff to the files it names, all or nothing. Files it
---changes or removes must have been read and left unchanged.
---@field patch fun(patch: string, opts?: { path?: string }): { path: string, revision: integer }[]

---@class Ctx.DiffHunk
---@field old_start integer
---@field old_lines integer
---@field new_start integer
---@field new_lines integer
---@field lines string[]                   Each keeps its leading " ", "-" or "+".

---@class Ctx.FilePatch
---@field old_path? string                 `nil` when the file is created.
---@field new_path? string                 `nil` when the file is removed.
---@field hunks Ctx.DiffHunk[]

---Unified diffs as text and as tables. No permission needed.
---@class Ctx.Diff
---@field create fun(old: string, new: string, opts?: { path?: string, context?: integer }): string
---@field parse fun(text: string): Ctx.FilePatch[]
---@field format fun(files: Ctx.FilePatch[]): string
---@field apply fun(text: string, patch: string|Ctx.FilePatch): string

---@class Ctx.FileRevision
---@field id integer
---@field parent integer
---@field operation "write"|"append"|"remove"
---@field timestamp_ms integer
---@field offset integer
---@field removed_bytes integer
---@field added_bytes integer
---@field before_size? integer
---@field after_size? integer

---@class Ctx.FileHistory
---@field current integer
---@field revisions Ctx.FileRevision[]

---@class Ctx.FileDiff
---@field revision Ctx.FileRevision
---@field removed string
---@field added string

---@class Ctx.HttpResponse
---@field status integer
---@field headers table<string, string>
---@field body string
---@field json fun(self: Ctx.HttpResponse): any

---@class Ctx.HttpOpts
---@field headers? table<string, string>
---@field timeout_ms? integer
---@field json? any

---@class Ctx.HttpClient
---@field get fun(self: Ctx.HttpClient, path: string, opts?: Ctx.HttpOpts): Ctx.HttpResponse
---@field post fun(self: Ctx.HttpClient, path: string, body?: any, opts?: Ctx.HttpOpts): Ctx.HttpResponse
---@field request fun(self: Ctx.HttpClient, req: table): Ctx.HttpResponse

---@class Ctx.Http
---@field get fun(url: string, opts?: Ctx.HttpOpts): Ctx.HttpResponse
---@field post fun(url: string, body?: any, opts?: Ctx.HttpOpts): Ctx.HttpResponse
---@field request fun(req: { method: string, url: string, headers?: table, json?: any, body?: string, timeout_ms?: integer }): Ctx.HttpResponse
---@field client fun(cfg: { base_url?: string, headers?: table, timeout_ms?: integer }): Ctx.HttpClient

---@class Ctx.WsFrame
---@field kind "text"|"binary"
---@field text? string

---@class Ctx.WsConn
---@field send fun(self: Ctx.WsConn, msg: string)
---@field send_binary fun(self: Ctx.WsConn, bytes: string)
---@field recv fun(self: Ctx.WsConn, timeout_ms?: integer): Ctx.WsFrame|nil
---@field recv_text fun(self: Ctx.WsConn, timeout_ms?: integer): string|nil
---@field each fun(self: Ctx.WsConn, fn: fun(frame: Ctx.WsFrame))
---@field close fun(self: Ctx.WsConn)
---@field is_closed fun(self: Ctx.WsConn): boolean
---@field url fun(self: Ctx.WsConn): string

---@class Ctx.Ws
---@field connect fun(url: string, opts?: { heartbeat_ms?: integer, heartbeat?: string }): Ctx.WsConn

---@class Ctx.Secret
---@field get fun(key: string): string|nil
---@field set fun(key: string, value: string)
---@field delete fun(key: string)
---@field exists fun(key: string): boolean
---@field list fun(): string[]

